{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-memory-kit.local/schemas/daimon-projection/v1/common.schema.json",
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[45][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "me_id": {"type": "string", "pattern": "^dm:being:v1:[A-Za-z0-9_-]{43}$"},
    "scoped": {"type": "string", "pattern": "^(?!.*\\.\\.)[a-z][a-z0-9.-]{1,31}:[A-Za-z0-9._:-]{1,160}$"},
    "projection_id": {"type": "string", "pattern": "^hmk:daimon-projection:v1:[A-Za-z0-9_-]{43}$"},
    "namespace_id": {"type": "string", "pattern": "^hmk:daimon-namespace:v1:[A-Za-z0-9_-]{43}$"},
    "receipt_id": {"type": "string", "pattern": "^hmk:daimon-(?:rebuild-)?receipt:v1:[A-Za-z0-9_-]{43}$"},
    "plan_id": {"type": "string", "pattern": "^hmk:daimon-rebuild-plan:v1:[A-Za-z0-9_-]{43}$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "api_version", "schema_version"],
      "properties": {
        "instance_id": {"$ref": "#/$defs/scoped"},
        "api_version": {"const": "1.0.0"},
        "schema_version": {"const": 1}
      }
    },
    "projector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"$ref": "#/$defs/scoped"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "hash"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "hash": {"$ref": "#/$defs/hash"}
      }
    },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "event_hash", "sequence", "predecessor_event_id", "predecessor_hash"],
      "properties": {
        "event_id": {"$ref": "#/$defs/uuid"},
        "event_hash": {"$ref": "#/$defs/hash"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "predecessor_event_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/uuid"}]},
        "predecessor_hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]}
      }
    },
    "head_current": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "event_hash", "sequence"],
      "properties": {
        "event_id": {"$ref": "#/$defs/uuid"},
        "event_hash": {"$ref": "#/$defs/hash"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "byte_length", "media_type", "classification", "text"],
      "properties": {
        "sha256": {"$ref": "#/$defs/hash"},
        "byte_length": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "media_type": {"enum": ["text/plain", "text/markdown"]},
        "classification": {"enum": ["public", "personal", "private", "protected"]},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "statement_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "byte_length", "media_type", "classification"],
      "properties": {
        "sha256": {"$ref": "#/$defs/hash"},
        "byte_length": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "media_type": {"enum": ["text/plain", "text/markdown"]},
        "classification": {"enum": ["public", "personal", "private", "protected"]}
      }
    },
    "statement_detail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "byte_length", "media_type", "classification", "text"],
      "properties": {
        "sha256": {"$ref": "#/$defs/hash"},
        "byte_length": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "media_type": {"enum": ["text/plain", "text/markdown"]},
        "classification": {"enum": ["public", "personal", "private", "protected"]},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection_id", "namespace_id", "memory_id", "author_me_id", "category", "head", "statement", "source_checkpoint", "active"],
      "properties": {
        "projection_id": {"$ref": "#/$defs/projection_id"},
        "namespace_id": {"$ref": "#/$defs/namespace_id"},
        "memory_id": {"$ref": "#/$defs/uuid"},
        "author_me_id": {"$ref": "#/$defs/me_id"},
        "category": {"enum": ["personal-experience", "personal-insight", "personal-skill"]},
        "head": {"$ref": "#/$defs/head_current"},
        "statement": {"$ref": "#/$defs/statement_ref"},
        "source_checkpoint": {"$ref": "#/$defs/checkpoint"},
        "active": {"type": "boolean"}
      }
    },
    "state_detail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection_id", "namespace_id", "memory_id", "author_me_id", "category", "head", "statement", "source_checkpoint", "active"],
      "properties": {
        "projection_id": {"$ref": "#/$defs/projection_id"},
        "namespace_id": {"$ref": "#/$defs/namespace_id"},
        "memory_id": {"$ref": "#/$defs/uuid"},
        "author_me_id": {"$ref": "#/$defs/me_id"},
        "category": {"enum": ["personal-experience", "personal-insight", "personal-skill"]},
        "head": {"$ref": "#/$defs/head_current"},
        "statement": {"$ref": "#/$defs/statement_detail"},
        "source_checkpoint": {"$ref": "#/$defs/checkpoint"},
        "active": {"type": "boolean"}
      }
    },
    "rebuild_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_id", "author_me_id", "category", "head", "statement"],
      "properties": {
        "memory_id": {"$ref": "#/$defs/uuid"},
        "author_me_id": {"$ref": "#/$defs/me_id"},
        "category": {"enum": ["personal-experience", "personal-insight", "personal-skill"]},
        "head": {"$ref": "#/$defs/head_current"},
        "statement": {"$ref": "#/$defs/statement"}
      }
    },
    "rebuild_prior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "manifest_hash", "source_checkpoint"],
      "properties": {
        "generation": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "manifest_hash": {"$ref": "#/$defs/hash"},
        "source_checkpoint": {"$ref": "#/$defs/checkpoint"}
      }
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_instance", "subject_me_id", "projector_id", "projector_version"],
      "properties": {
        "source_instance": {"$ref": "#/$defs/scoped"},
        "subject_me_id": {"$ref": "#/$defs/me_id"},
        "projector_id": {"$ref": "#/$defs/scoped"},
        "projector_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    }
  }
}
